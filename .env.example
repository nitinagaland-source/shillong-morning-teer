# Firebase Admin SDK credentials. These are SERVER-ONLY.
# Never prefix these values with VITE_ and never commit your real .env file.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# First admin account. On first login, the password is salted+hashed in Firestore.
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="use-a-strong-password-here"

# Use different random secrets, at least 32 characters each.
SESSION_SECRET="replace-with-a-long-random-session-secret"
CRON_SECRET="replace-with-a-different-long-random-cron-secret"

# Optional local development port
PORT="3000"
