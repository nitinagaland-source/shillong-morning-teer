{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/common-number",
      "destination": "/"
    },
    {
      "source": "/dream-number",
      "destination": "/"
    },
    {
      "source": "/previous-results",
      "destination": "/"
    },
    {
      "source": "/analytics",
      "destination": "/"
    },
    {
      "source": "/predict-target",
      "destination": "/"
    },
    {
      "source": "/deal",
      "destination": "/"
    },
    {
      "source": "/notices",
      "destination": "/"
    }
  ],
  "outputDirectory": "public"
}
